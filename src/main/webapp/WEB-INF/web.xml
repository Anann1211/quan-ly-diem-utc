<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">

    <display-name>UTC Grade Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- 1. FILTERS (Cấu hình & Bảo mật RBAC, UTF-8) -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>vn.edu.utc.grade.config.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>vn.edu.utc.grade.config.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. SERVLETS -->
    <!-- Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/change-password</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets (Tách biệt theo nghiệp vụ) -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
        <url-pattern>/admin/statistics</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GradeApprovalServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.GradeApprovalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GradeApprovalServlet</servlet-name>
        <url-pattern>/admin/grade-approval</url-pattern>
        <url-pattern>/admin/appeals</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AcademicManageServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.AcademicManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AcademicManageServlet</servlet-name>
        <url-pattern>/admin/subjects</url-pattern>
        <url-pattern>/admin/classes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuditLogServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.AuditLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditLogServlet</servlet-name>
        <url-pattern>/admin/audit-logs</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserManageServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.UserManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserManageServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AcademicClassServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.AcademicClassServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AcademicClassServlet</servlet-name>
        <url-pattern>/admin/academic-classes</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>FacultyGradeServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.FacultyGradeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacultyGradeServlet</servlet-name>
        <url-pattern>/admin/faculty-grades</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminScheduleServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.admin.AdminScheduleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminScheduleServlet</servlet-name>
        <url-pattern>/admin/schedules</url-pattern>
    </servlet-mapping>

    <!-- Lecturer Servlet -->
    <servlet>
        <servlet-name>LecturerServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.lecturer.LecturerServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>2097152</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>LecturerServlet</servlet-name>
        <url-pattern>/lecturer/*</url-pattern>
    </servlet-mapping>

    <!-- Student Servlet -->
    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>vn.edu.utc.grade.controller.student.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/student/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>120</session-timeout>
    </session-config>

</web-app>
